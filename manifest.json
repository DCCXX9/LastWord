{
  "manifest_version": 3,
  "name": "Last.fm Personal Library",
  "version": "0.8.1",
  "version_name": "0.8.1 beta",
  "description": "Personalise your Last.fm library with local display names, iTunes XML casing import and continuous scrolling.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "artwork.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "artwork.js", "pages.js", "content.js", "albumless-reader.js", "albumless-engine.js", "native-edit.js", "artwork-albums.js", "artwork-source.js", "albumless-scan.js"],
    "css": ["content.css", "lfm-ui.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {
    "default_title": "Last.fm Personal Library",
    "default_popup": "popup.html"
  }
}
