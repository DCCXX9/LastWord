{
  "manifest_version": 3,
  "name": "Last.fm Personal Library",
  "version": "0.3.4",
  "description": "Personal display names and continuous library scrolling.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.last.fm/*"],
      "js": ["rules.js", "content.js", "native-edit.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Last.fm Personal Library",
    "default_popup": "popup.html"
  }
}
