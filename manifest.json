{
  "manifest_version": 3,
  "name": "LastWord for Last.fm",
  "version": "0.9.28",
  "version_name": "0.9.28 beta",
  "description": "Personalise your Last.fm library with local display names, iTunes XML casing import and continuous scrolling.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "offscreen"],
  "host_permissions": ["https://www.last.fm/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "redirects.js", "image-recovery.js", "artwork.js", "content.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "redirects.js", "image-recovery.js", "artwork.js", "pages.js", "content.js", "native-edit.js", "artwork-albums.js", "artwork-source.js"],
    "css": ["content.css", "lfm-ui.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {
    "default_title": "LastWord for Last.fm",
    "default_popup": "popup.html"
  }
}
