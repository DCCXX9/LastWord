{
  "manifest_version": 3,
  "name": "Last.fm Personal Library",
  "version": "0.6.15",
  "description": "Personal display names and continuous library scrolling.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "artwork.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://www.last.fm/*"],
    "js": ["rules.js", "store.js", "adapter.js", "artwork.js", "pages.js", "content.js", "native-edit.js", "artwork-albums.js", "artwork-source.js"],
    "css": ["content.css", "lfm-ui.css"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": {
    "default_title": "Last.fm Personal Library",
    "default_popup": "popup.html"
  }
}
